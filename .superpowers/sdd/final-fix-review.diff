 void discoChasePoll(float bpm) {
     unsigned long now = millis();
     float dt = (float)(now - s_last_ms) / 1000.0f;
     if (dt <= 0.0f) dt = 0.001f;
     s_last_ms = now;
 
     if (s_direction == 0) {
         discoRingFill(0, 0, 0);
         discoRingShow();
         return;
     }
 
