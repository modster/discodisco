     if (s_pos < 0.0f) s_pos += (float)DISCO_RING_LEDS;
 
     uint8_t r = (s_color >> 16) & 0xFF;
     uint8_t g = (s_color >> 8) & 0xFF;
     uint8_t b = s_color & 0xFF;
 
     /* Head at s_pos, fading trail of 3 LEDs behind it. */
