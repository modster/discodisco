-            leds[i] = color
     rpm = scene.bpm_endpoints["fast_rpm"]
     return [
-        {"tool": "ring_set", "leds": leds},
-        {"tool": "stepper_set", "rpm": rpm, "dir": _DIR_MAP.get(scene.direction, 1)},
